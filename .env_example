# Vorlage für .env (Studio-Host auf dem Stream-PC). Kopieren nach .env und Werte eintragen.
# .env steht in .gitignore und landet nie im Repo. Vorhandene Umgebungsvariablen haben Vorrang.

# --- Verbindung zum EBS (Testserver) ---
# Ohne Angabe: lokaler EBS auf ws://127.0.0.1:5090/api/v1/studio
GTASTREAM_EBS=wss://2-29-164-176.sslip.io/api/v1/studio
# Auf dem Testserver das Admin-Token: sudo grep ADMIN_TOKEN /etc/gtastream/env
GTASTREAM_STUDIO_TOKEN=

# --- Texte der Regie (Claude) ---
# Leer: Banner und Sprachzeilen kommen aus Vorlagen. Schlüssel: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Modell für die Regie, Standard claude-haiku-5-5
GTASTREAM_LLM_MODEL=claude-haiku-5-5

# --- Stimme ---
# ElevenLabs (Premium-Stimme). Leer: nur Piper oder keine Stimme.
ELEVENLABS_API_KEY=
# Stimme aus deiner ElevenLabs-Bibliothek (Voice ID, z. B. aus der Voice Library)
ELEVENLABS_VOICE_ID=
# Modell, Standard eleven_flash_v2_5 (günstig, schnell)
ELEVENLABS_MODEL=eleven_flash_v2_5
# Stunden mit ElevenLabs (Ortszeit, von-bis), sonst Piper. Konzept: 4 h am Abend.
GTASTREAM_TTS_PREMIUM_HOURS=18-22

# Piper (lokale Stimme, kostenlos). Programm und Stimme, z. B. de_DE-thorsten-medium.onnx
# Leer: außerhalb der Premium-Zeit spricht die Figur nicht, Texte stehen nur im Overlay.
PIPER_PATH=
PIPER_VOICE=

# --- Overlay für OBS ---
# Browser-Quelle in OBS: http://127.0.0.1:7780/  (Größe 1920x1080, "Audio über OBS steuern" an)
GTASTREAM_OVERLAY_URL=http://127.0.0.1:7780
