<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.14.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The overlay page ships inside the program, so OBS finds it wherever the studio host runs from. -->
    <EmbeddedResource Include="Overlay\overlay.html" LogicalName="overlay.html" />
  </ItemGroup>

</Project>
